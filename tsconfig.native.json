{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "lib": ["es2021"],
    "target": "es2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {"*": ["lens/Assets/*", "lens/Packages/*", "lens/Cache/TypeScript/Src/Packages/*"]}
  },
  "include": ["lens-src/**/*.ts", "lens/Cache/TypeScript/lib/LensifyTS/Declarations/**/*.d.ts"]
}
